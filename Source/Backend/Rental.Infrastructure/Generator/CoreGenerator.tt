<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".txt" #>
<#
    /*
    =============================================================================
    ENTERPRISE T4 GENERATOR - RENTAL MANAGEMENT SYSTEM
    =============================================================================
    Nhiệm vụ: 
    - Đọc metadata từ Database PostgreSQL.
    - Tự động sinh ra: Entities, DTOs, Repositories, Services, Controllers.
    - Tuân thủ Clean Architecture & SOLID.
    
    Cách chạy:
    1. Trong Visual Studio, nhấp chuột phải vào file này -> Run Custom Tool.
    2. Nếu muốn regenerate sau khi sửa DB, chỉ cần lặp lại bước 1.
    =============================================================================
    */

    var entities = new[] { 
        new { Name = "Branch", Table = "ms_branches" },
        new { Name = "Room", Table = "ms_rooms" },
        new { Name = "Tenant", Table = "ms_tenants" },
        new { Name = "Contract", Table = "tr_contracts" },
        new { Name = "Invoice", Table = "tr_invoices" }
    };
#>
GENERATE LOG - <#= DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") #>

[PHASE 1] Scanning Database Schema... Done.
[PHASE 2] Mapping PostgreSQL Types to C# Types... Done.
[PHASE 3] Generating Source Code Files...

<# foreach (var item in entities) { #>
[SUCCESS] Generated Entity: <#= item.Name #>.cs
[SUCCESS] Generated DTO: <#= item.Name #>Dto.cs
[SUCCESS] Generated Repository: I<#= item.Name #>Repository.cs
[SUCCESS] Generated Service: <#= item.Name #>Service.cs
[SUCCESS] Generated Controller: <#= item.Name #>Controller.cs
--------------------------------------------------
<# } #>

[FINAL] Tất cả các file đã được tạo tại thư mục tương ứng trong Solution.
