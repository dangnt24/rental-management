@model Rental.Application.DTOs.DashboardStatsDto
@{
    ViewData["Title"] = "Tổng quan";
}

<h1 class="text-2xl font-bold mb-8 text-gray-800">Bảng điều khiển hệ thống</h1>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <div class="bg-white p-6 rounded-lg shadow-sm border-l-4 border-blue-500">
        <p class="text-sm text-gray-500 font-medium">Tổng số phòng</p>
        <p class="text-3xl font-bold text-gray-800">@Model.TotalRooms</p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-sm border-l-4 border-green-500">
        <p class="text-sm text-gray-500 font-medium">Phòng đang thuê</p>
        <p class="text-3xl font-bold text-gray-800">@Model.RentedRooms</p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500">
        <p class="text-sm text-gray-500 font-medium">Phòng trống</p>
        <p class="text-3xl font-bold text-gray-800">@Model.EmptyRooms</p>
    </div>
    <div class="bg-white p-6 rounded-lg shadow-sm border-l-4 border-purple-500">
        <p class="text-sm text-gray-500 font-medium">Doanh thu tháng</p>
        <p class="text-3xl font-bold text-gray-800">@Model.MonthlyRevenue.ToString("N0") đ</p>
    </div>
</div>
