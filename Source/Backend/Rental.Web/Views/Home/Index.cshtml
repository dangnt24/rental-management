@model Rental.Application.DTOs.DashboardStatsDto
@{
    ViewData["Title"] = "Tổng quan";
    var occupancyRate = Model.TotalRooms > 0 ? Math.Round((double)Model.RentedRooms / Model.TotalRooms * 100) : 0;
    var emptyRate = Model.TotalRooms > 0 ? Math.Round((double)Model.EmptyRooms / Model.TotalRooms * 100) : 0;
    var maintenanceCount = Model.TotalRooms - Model.RentedRooms - Model.EmptyRooms;
}

<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Bảng điều khiển</h1>
            <p class="text-sm text-gray-400 mt-1">Tổng quan hệ thống quản lý nhà trọ</p>
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-400">
            <i class="fas fa-calendar-alt"></i>
            <span>@DateTime.Now.ToString("dd/MM/yyyy")</span>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="card-hover bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center">
                    <i class="fas fa-door-open text-blue-600 text-xl"></i>
                </div>
                <span class="text-xs font-medium text-blue-600 bg-blue-50 px-2 py-1 rounded-full">Tổng số</span>
            </div>
            <p class="text-sm text-gray-400 mb-1">Tổng số phòng</p>
            <p class="text-3xl font-bold text-gray-800">@Model.TotalRooms</p>
            <div class="mt-3 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-blue-500 rounded-full" style="width: 100%"></div>
            </div>
        </div>

        <div class="card-hover bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-green-500/10 flex items-center justify-center">
                    <i class="fas fa-user-check text-green-600 text-xl"></i>
                </div>
                <span class="text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded-full">@occupancyRate%</span>
            </div>
            <p class="text-sm text-gray-400 mb-1">Phòng đang thuê</p>
            <p class="text-3xl font-bold text-gray-800">@Model.RentedRooms</p>
            <div class="mt-3 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-green-500 rounded-full" style="width: @occupancyRate%"></div>
            </div>
        </div>

        <div class="card-hover bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-yellow-500/10 flex items-center justify-center">
                    <i class="fas fa-hourglass-empty text-yellow-600 text-xl"></i>
                </div>
                <span class="text-xs font-medium text-yellow-600 bg-yellow-50 px-2 py-1 rounded-full">@emptyRate%</span>
            </div>
            <p class="text-sm text-gray-400 mb-1">Phòng trống</p>
            <p class="text-3xl font-bold text-gray-800">@Model.EmptyRooms</p>
            <div class="mt-3 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-yellow-500 rounded-full" style="width: @emptyRate%"></div>
            </div>
        </div>

        <div class="card-hover bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center">
                    <i class="fas fa-coins text-purple-600 text-xl"></i>
                </div>
                <span class="text-xs font-medium text-purple-600 bg-purple-50 px-2 py-1 rounded-full">Tháng này</span>
            </div>
            <p class="text-sm text-gray-400 mb-1">Doanh thu tháng</p>
            <p class="text-3xl font-bold text-gray-800">@Model.MonthlyRevenue.ToString("N0")<span class="text-lg text-gray-400">đ</span></p>
            <div class="mt-3 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-purple-500 rounded-full" style="width: 100%"></div>
            </div>
        </div>
    </div>

    <!-- Bottom Section -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Room Status Overview -->
        <div class="lg:col-span-2 bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
            <h2 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                <i class="fas fa-chart-bar text-blue-500 mr-2"></i> Tổng quan phòng
            </h2>
            <div class="grid grid-cols-3 gap-4">
                <div class="bg-green-50 rounded-lg p-4 text-center">
                    <p class="text-2xl font-bold text-green-600">@Model.RentedRooms</p>
                    <p class="text-xs text-green-500 mt-1">Đang thuê</p>
                </div>
                <div class="bg-yellow-50 rounded-lg p-4 text-center">
                    <p class="text-2xl font-bold text-yellow-600">@Model.EmptyRooms</p>
                    <p class="text-xs text-yellow-500 mt-1">Phòng trống</p>
                </div>
                <div class="bg-gray-50 rounded-lg p-4 text-center">
                    <p class="text-2xl font-bold text-gray-600">@maintenanceCount</p>
                    <p class="text-xs text-gray-500 mt-1">Bảo trì</p>
                </div>
            </div>
            <!-- Mini bar chart -->
            <div class="mt-6 flex items-end gap-2 h-32">
                @{
                    var maxVal = new[] { Model.RentedRooms, Model.EmptyRooms, maintenanceCount, 1 }.Max();
                }
                <div class="flex-1 flex flex-col items-center">
                    <div class="w-full bg-green-500 rounded-t-lg transition-all" style="height: @(Math.Round((double)Model.RentedRooms / maxVal * 100))px"></div>
                    <span class="text-xs text-gray-400 mt-1">Đang thuê</span>
                </div>
                <div class="flex-1 flex flex-col items-center">
                    <div class="w-full bg-yellow-500 rounded-t-lg transition-all" style="height: @(Math.Round((double)Model.EmptyRooms / maxVal * 100))px"></div>
                    <span class="text-xs text-gray-400 mt-1">Trống</span>
                </div>
                <div class="flex-1 flex flex-col items-center">
                    <div class="w-full bg-gray-400 rounded-t-lg transition-all" style="height: @(Math.Round((double)maintenanceCount / maxVal * 100))px"></div>
                    <span class="text-xs text-gray-400 mt-1">Bảo trì</span>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-white rounded-xl p-6 border border-gray-100 shadow-sm">
            <h2 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                <i class="fas fa-bolt text-yellow-500 mr-2"></i> Thao tác nhanh
            </h2>
            <div class="space-y-3">
                <a href="/Room" class="flex items-center p-3 rounded-lg bg-blue-50 text-blue-700 hover:bg-blue-100 transition">
                    <i class="fas fa-plus-circle mr-3"></i>
                    <span class="text-sm font-medium">Thêm phòng mới</span>
                </a>
                <a href="/Tenant" class="flex items-center p-3 rounded-lg bg-green-50 text-green-700 hover:bg-green-100 transition">
                    <i class="fas fa-user-plus mr-3"></i>
                    <span class="text-sm font-medium">Thêm người thuê</span>
                </a>
                <a href="/Contract" class="flex items-center p-3 rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition">
                    <i class="fas fa-file-signature mr-3"></i>
                    <span class="text-sm font-medium">Tạo hợp đồng</span>
                </a>
                <a href="/Billing" class="flex items-center p-3 rounded-lg bg-purple-50 text-purple-700 hover:bg-purple-100 transition">
                    <i class="fas fa-file-invoice mr-3"></i>
                    <span class="text-sm font-medium">Tạo hóa đơn</span>
                </a>
                <a href="/Incident" class="flex items-center p-3 rounded-lg bg-red-50 text-red-700 hover:bg-red-100 transition">
                    <i class="fas fa-exclamation-circle mr-3"></i>
                    <span class="text-sm font-medium">Báo sự cố</span>
                </a>
            </div>
        </div>
    </div>
</div>
