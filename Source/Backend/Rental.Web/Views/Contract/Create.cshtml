@model Rental.Application.DTOs.ContractDto
@{
    ViewData["Title"] = "Tạo hợp đồng";
}

<div class="mb-6">
    <a href="/Contract" class="text-blue-600 hover:text-blue-800 text-sm"><i class="fas fa-arrow-left mr-1"></i>Quay lại danh sách</a>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 max-w-2xl">
    <h1 class="text-xl font-bold mb-6"><i class="fas fa-file-contract text-blue-600 mr-2"></i>Tạo hợp đồng thuê phòng</h1>
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
                <label class="block text-sm font-medium mb-1">ID Phòng</label>
                <input name="RoomId" type="number" class="w-full border rounded-md px-3 py-2" required placeholder="Nhập ID phòng" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Tiền cọc</label>
                <input name="DepositAmount" type="number" class="w-full border rounded-md px-3 py-2" value="0" />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Giá thuê thực tế</label>
                <input name="ActualRentPrice" type="number" class="w-full border rounded-md px-3 py-2" required />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Ngày bắt đầu</label>
                <input name="StartDate" type="date" class="w-full border rounded-md px-3 py-2" required />
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">Ngày kết thúc</label>
                <input name="EndDate" type="date" class="w-full border rounded-md px-3 py-2" />
            </div>
        </div>
        <div class="mb-4">
            <label class="block text-sm font-medium mb-1">Ghi chú</label>
            <textarea name="Remark" class="w-full border rounded-md px-3 py-2" rows="2"></textarea>
        </div>

        <div class="mb-6 p-4 bg-gray-50 rounded-lg border border-dashed border-gray-300">
            <label class="block text-sm font-semibold text-gray-700 mb-2">
                <i class="fas fa-paperclip mr-1"></i>Tệp đính kèm hợp đồng <span class="text-xs font-normal text-gray-400">(tải lên sau khi tạo)</span>
            </label>
            <p class="text-xs text-gray-400">Sau khi tạo hợp đồng, bạn có thể tải nhiều tệp từ trang chi tiết</p>
        </div>

        <div class="flex justify-end gap-2">
            <a href="/Contract" class="px-4 py-2 border rounded-md text-sm hover:bg-gray-50"><i class="fas fa-times mr-1"></i>Hủy</a>
            <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-md text-sm hover:bg-blue-700"><i class="fas fa-save mr-1"></i>Lưu hợp đồng</button>
        </div>
    </form>
</div>